<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='plant_pot'>
    <static>true</static>
    <link name='pot_link'>
      <collision name='col_pot'>
        <geometry><cylinder><radius>0.18</radius><length>0.4</length></cylinder></geometry>
        <pose>0 0 0.2 0 0 0</pose>
      </collision>
      <visual name='vis_pot'>
        <geometry><cylinder><radius>0.18</radius><length>0.4</length></cylinder></geometry>
        <pose>0 0 0.2 0 0 0</pose>
        <material>
          <ambient>0.7 0.5 0.3 1</ambient>
          <diffuse>0.8 0.6 0.4 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- soil -->
      <collision name='col_soil'>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <pose>0 0 0.35 0 0 0</pose>
      </collision>
      <visual name='vis_soil'>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <pose>0 0 0.35 0 0 0</pose>
        <material>
          <ambient>0.4 0.3 0.2 1</ambient>
          <diffuse>0.5 0.4 0.3 1</diffuse>
        </material>
      </visual>
      <!-- plant -->
      <collision name='col_plant'>
        <geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry>
        <pose>0 0 0.5 0 0 0</pose>
      </collision>
      <visual name='vis_plant'>
        <geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry>
        <pose>0 0 0.5 0 0 0</pose>
        <material>
          <ambient>0.2 0.6 0.2 1</ambient>
          <diffuse>0.3 0.7 0.3 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
