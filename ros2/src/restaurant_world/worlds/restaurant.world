<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='restaurant_world'>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Restaurant lighting -->
    <light name='main_light' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.85 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Ambient restaurant lighting -->
    <light name='ambient_light' type='directional'>
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.95</constant>
        <linear>0.005</linear>
        <quadratic>0.0005</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <!-- Simple ground plane -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.75 0.7 1</ambient>
            <diffuse>0.7 0.65 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls: 8m x 6m interior -->
    <model name='walls'>
      <static>true</static>
      <link name='walls_link'>
        <!-- North wall -->
        <collision name='north_col'>
          <geometry><box><size>8 0.1 2.5</size></box></geometry>
          <pose>0 3.0 1.25 0 0 0</pose>
        </collision>
        <visual name='north_vis'>
          <geometry><box><size>8 0.1 2.5</size></box></geometry>
          <pose>0 3.0 1.25 0 0 0</pose>
          <material>
            <ambient>0.9 0.85 0.8 1</ambient>
            <diffuse>0.8 0.75 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <!-- South wall -->
        <collision name='south_col'>
          <geometry><box><size>8 0.1 2.5</size></box></geometry>
          <pose>0 -3.0 1.25 0 0 0</pose>
        </collision>
        <visual name='south_vis'>
          <geometry><box><size>8 0.1 2.5</size></box></geometry>
          <pose>0 -3.0 1.25 0 0 0</pose>
          <material>
            <ambient>0.9 0.85 0.8 1</ambient>
            <diffuse>0.8 0.75 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <!-- West wall -->
        <collision name='west_col'>
          <geometry><box><size>0.1 6 2.5</size></box></geometry>
          <pose>-4.0 0 1.25 0 0 0</pose>
        </collision>
        <visual name='west_vis'>
          <geometry><box><size>0.1 6 2.5</size></box></geometry>
          <pose>-4.0 0 1.25 0 0 0</pose>
          <material>
            <ambient>0.9 0.85 0.8 1</ambient>
            <diffuse>0.8 0.75 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <!-- East wall (with 1.2m doorway at y=-2.5) -->
        <collision name='east_upper_col'>
          <geometry><box><size>0.1 4.8 2.5</size></box></geometry>
          <pose>4.0 0.6 1.25 0 0 0</pose>
        </collision>
        <collision name='east_lower_col'>
          <geometry><box><size>0.1 0.6 2.5</size></box></geometry>
          <pose>4.0 -2.7 1.25 0 0 0</pose>
        </collision>
        <visual name='east_vis_a'>
          <geometry><box><size>0.1 4.8 2.5</size></box></geometry>
          <pose>4.0 0.6 1.25 0 0 0</pose>
          <material>
            <ambient>0.9 0.85 0.8 1</ambient>
            <diffuse>0.8 0.75 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name='east_vis_b'>
          <geometry><box><size>0.1 0.6 2.5</size></box></geometry>
          <pose>4.0 -2.7 1.25 0 0 0</pose>
          <material>
            <ambient>0.9 0.85 0.8 1</ambient>
            <diffuse>0.8 0.75 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Interior walls and dividers -->
    <!-- Kitchen divider wall (separates kitchen from dining) -->
    <model name='kitchen_divider'>
      <static>true</static>
      <allow_auto_disable>false</allow_auto_disable>
      <link name='divider_link'>
        <kinematic>true</kinematic>
        <collision name='divider_col'>
          <geometry><box><size>0.1 3.5 2.5</size></box></geometry>
          <pose>0 0 1.25 0 0 0</pose>
        </collision>
        <visual name='divider_vis'>
          <geometry><box><size>0.1 3.5 2.5</size></box></geometry>
          <pose>0 0 1.25 0 0 0</pose>
