            <diffuse>0.7 0.6 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <!-- Service opening in divider -->
        <collision name='opening_col_left'>
          <geometry><box><size>0.1 0.8 2.5</size></box></geometry>
          <pose>0 1.35 1.25 0 0 0</pose>
        </collision>
        <collision name='opening_col_right'>
          <geometry><box><size>0.1 0.8 2.5</size></box></geometry>
          <pose>0 -1.35 1.25 0 0 0</pose>
        </collision>
      </link>
    </model>

